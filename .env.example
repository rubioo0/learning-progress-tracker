# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
FORCE_SQLITE=false
ALLOW_SQLITE_FALLBACK=true
DATABASE_PATH=./learning_progress.db

# Storage
STORAGE_BACKEND=cloudinary
UPLOAD_DIRECTORY=uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=qa-road-attachments
MAX_PREVIEW_FILE_SIZE=204800

# Gemini AI
GEMINI_API_KEY=
AI_FILE_PERSISTENCE=false
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_FALLBACK_ORDER=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
AI_ALLOW_MODEL_FALLBACK=true

# Production safety guard
REQUIRE_PROD_EXTERNAL_SERVICES=false

# Optional CORS
# CORS_ALLOWED_ORIGINS=https://your-app.onrender.com,https://your-custom-domain.com
ALLOW_NULL_ORIGIN=true

# Optional: disable validator endpoint on restricted environments
CODE_VALIDATION_ENABLED=true
